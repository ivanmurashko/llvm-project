// RUN: split-file %s %t
// RUN: clang-tidy %t/module.cpp --checks='-*,cir-lifetime-check' --config='{}' -- -target x86_64-unknown-linux-gnu -std=c++20 2>&1 | count 0
// RUN: clang-tidy %t/module.cpp --checks='-*,cir-lifetime-check' --config='{CheckOptions: {cir-lifetime-check.AnalyzeUnusedMainFileFunctions: true}}' -- -target x86_64-unknown-linux-gnu -std=c++20 2>&1 | FileCheck %s --check-prefix=MODULE --implicit-check-not='warning:' --implicit-check-not='error:'
// RUN: clang-tidy %t/cuda.cu --checks='-*,cir-lifetime-check' --config='{}' -- -target x86_64-unknown-linux-gnu -std=c++20 --cuda-host-only -nocudainc -nocudalib 2>&1 | count 0
// RUN: clang-tidy %t/cuda.cu --checks='-*,cir-lifetime-check' --config='{CheckOptions: {cir-lifetime-check.AnalyzeUnusedMainFileFunctions: true}}' -- -target x86_64-unknown-linux-gnu -std=c++20 --cuda-host-only -nocudainc -nocudalib 2>&1 | FileCheck %s --check-prefix=CUDA --implicit-check-not='warning:' --implicit-check-not='error:'

// MODULE: warning: use of invalid pointer 'export_pointer' [cir-lifetime-check]
// CUDA: warning: use of invalid pointer 'host_pointer' [cir-lifetime-check]

//--- module.cpp
export module lifetime_roots;
export {
inline void exported_root() {
  int *export_pointer = nullptr;
  *export_pointer = 1;
}
}

//--- cuda.cu
inline void ordinary_host_root() {
  int *host_pointer = nullptr;
  *host_pointer = 1;
}

// Device-specific definitions are excluded as roots even on the host pass.
__attribute__((host, device)) inline void dual_target(unsigned value) {
  (void)__builtin_elementwise_clzg(value);
}
__attribute__((device)) inline void device_target(unsigned value) {
  (void)__builtin_elementwise_clzg(value);
}
