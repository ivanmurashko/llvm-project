# REQUIRES: system-linux || system-darwin
# RUN: split-file %s %t
# RUN: %python %t/test.py %S/../../../clang-tidy/tool/benchmark-cir-lifetime.py %t

#--- fixture.py
import json
from pathlib import Path
import sys
import time

if "--version" in sys.argv:
    print("fixture clang-tidy version 24")
    sys.exit(0)
if "--list-checks" in sys.argv:
    print("Enabled checks:\n    cir-lifetime-check\n    bugprone-use-after-move")
    sys.exit(0)
config = json.loads(next(a.split("=", 1)[1] for a in sys.argv if a.startswith("--config=")))
check = config["Checks"].removeprefix("-*,")
assert check in ("cir-lifetime-check", "bugprone-use-after-move")
assert "--checks=-*," + check in sys.argv
assert config["WarningsAsErrors"] == ""
assert all(k.startswith(check + ".") for k in config["CheckOptions"])
assert not any(a in ("--fix", "-fix") for a in sys.argv)
output = Path(next(a.split("=", 1)[1] for a in sys.argv if a.startswith("--export-fixes=")))
source = Path(sys.argv[-1])
if "--enable-check-profile" in sys.argv and source.stem != "missing-profile":
    directory = Path(next(a.split("=", 1)[1] for a in sys.argv if a.startswith("--store-check-profile=")))
    directory.mkdir()
    times = {"time.clang-tidy." + check + "." + key: value
             for key, value in [("wall", 0.02), ("user", 0.01), ("sys", 0.001)]}
    if source.stem == "invalid-profile":
        times["time.clang-tidy." + check + ".wall"] = -1
    phases = {name: {"wall_seconds": 0.03 if name == "tu_callbacks" else 0.01,
                     "user_seconds": 0.008, "sys_seconds": 0.001}
              for name in ("consumer_setup", "frontend_before_tu", "tu_callbacks")}
    if source.stem == "invalid-phase":
        phases["tu_callbacks"]["wall_seconds"] = -1
    (directory / "timing.json").write_text(json.dumps({"file": str(source), "profile": times,
                                                       "phase_schema_version": 1, "phases": phases}))
phase_arg = next((a.split("=", 1)[1] for a in sys.argv if a.startswith("--store-phase-profile=")), None)
if phase_arg and source.stem != "missing-profile":
    directory = Path(phase_arg)
    directory.mkdir()
    bounds = dict(zip(("consumer_entry", "consumer_ready", "tu_entry", "tu_exit"),
                      (0, 10000000, 20000000, 50000000)))
    if source.stem == "invalid-phase": bounds["tu_exit"] = -1
    (directory / "test.phases.json").write_text(json.dumps({
        "schema_version": 1, "file": str(source), "build_directory": str(Path.cwd()),
        "pid": 1, "sequence": 0, "checks": [check], "complete": True,
        "clock_reads": 4, "stock_profiling": "--enable-check-profile" in sys.argv,
        "frontend_error_before_tu": False,
        "clock": {"name": "std::chrono::steady_clock", "is_steady": True,
                  "unit": "nanoseconds", "period_num": 1, "period_den": 1000000000},
        "boundaries_ns": bounds}))
if check + ".ProfileOutput" in config["CheckOptions"]:
    path = Path(config["CheckOptions"][check + ".ProfileOutput"])
    threads = int(config["CheckOptions"].get(check + ".NumThreads", "0"))
    nodes = [{"name": name, "wall": {"duration": 0.001}, "passes": [{}]}
             for name in ["CIR generation", "CIR verification", "CIRCanonicalizePass", "LifetimeCheckPass"]]
    path.write_text(json.dumps({"schema_version": 1, "file": str(source), "complete": source.stem != "incomplete-cir",
                               "requested_threads": threads, "effective_threads": threads or 4,
                               "timing": nodes}))

event = {"variant": Path(sys.argv[0]).name, "phase": output.parent.name,
         "file": source.name, "check": check, "time": time.clock_gettime(time.CLOCK_MONOTONIC)}
trace = Path(sys.argv[0]).parent / "trace.jsonl"
with trace.open("a") as stream:
    stream.write(json.dumps(dict(event, event="start")) + "\n")
time.sleep(0.06)
if source.stem == "invalidate-input":
    (Path(sys.argv[0]).parent / "input.h").write_text("modified during run")
if source.stem == "warmup-failure" and output.parent.name.startswith("warmup"):
    print("error: deliberate warmup failure", file=sys.stderr)
    sys.exit(1)
if source.stem == "measured-failure" and output.parent.name == "repeat-002" and event["variant"] == "candidate":
    print("error: deliberate measured failure", file=sys.stderr)
    sys.exit(1)
message = "use of moved-from value 'x'" if check == "cir-lifetime-check" else "'x' used after it was moved"
note = "moved here via std::move or rvalue reference" if check == "cir-lifetime-check" else "move occurred here"
print(f"{source}:1:1: warning: {message} [{check}]", file=sys.stderr)
print(f"{source}:1:2: note: {note}", file=sys.stderr)
output.write_text(json.dumps({"MainSourceFile": str(source), "Diagnostics": [{
    "DiagnosticName": check, "Level": "Warning", "BuildDirectory": str(Path.cwd()),
    "DiagnosticMessage": {"Message": message, "FilePath": str(source), "FileOffset": 0,
                          "Replacements": [], "Ranges": [{"FilePath": str(source), "FileOffset": 0, "Length": 1}]},
    "Notes": [{"Message": note, "FilePath": str(source), "FileOffset": 1, "Replacements": []}]}]}))
with trace.open("a") as stream:
    stream.write(json.dumps(dict(event, event="end", time=time.clock_gettime(time.CLOCK_MONOTONIC))) + "\n")

#--- driver.py
import json
import shlex
import sys
if "--version" in sys.argv:
    print("fixture clang version 24")
    sys.exit(0)
if "-###" in sys.argv:
    language = "c++"
    standard = "gnu++17"
    for i, arg in enumerate(sys.argv):
        if arg == "-x": language = sys.argv[i + 1]
        elif arg.startswith("-std="): standard = arg.split("=", 1)[1]
    print(shlex.join(["fixture-clang", "-cc1", "-x", language, "-std=" + standard]), file=sys.stderr)
    sys.exit(0)
if "-cc1" in sys.argv:
    standard = next((a.split("=", 1)[1] for a in sys.argv if a.startswith("-std=")), "gnu++17")
    print("CIR_BENCH_CXX11" if standard not in ("c++98", "gnu++98", "c++03", "gnu++03") else "CIR_BENCH_PRE_CXX11")
    sys.exit(0)
sys.exit(2)

#--- test.py
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import unittest

RUNNER = Path(sys.argv.pop(1)).resolve()
ROOT = Path(sys.argv.pop(1)).resolve()
HAS_YAML = importlib.util.find_spec("yaml") is not None


class ExtendedBenchmarkTest(unittest.TestCase):
    def setUp(self):
        self.work = ROOT / self._testMethodName
        shutil.rmtree(self.work, ignore_errors=True)
        self.work.mkdir()
        self.source = self.work / "source"
        self.source.mkdir()
        self.build = self.work / "build"
        self.build.mkdir()
        for name, fixture in [("baseline", "fixture.py"), ("candidate", "fixture.py"), ("clang++", "driver.py")]:
            path = self.work / name
            path.write_text("#!" + sys.executable + "\n" + (ROOT / fixture).read_text())
            path.chmod(0o755)

    def database(self, names):
        entries = []
        for name, flags in names:
            source = self.source / (name + ".cpp")
            source.write_text("int x;\n")
            entries.append({"file": str(source), "directory": str(self.build),
                            "arguments": [str(self.work / "clang++"), *flags, "-c", str(source)]})
        (self.build / "compile_commands.json").write_text(json.dumps(entries))
        return entries

    def run_benchmark(self, *extra, expected=0):
        args = [sys.executable, str(RUNNER), "--baseline", str(self.work / "baseline"),
                "--candidate", str(self.work / "candidate"), "--baseline-revision", "a" * 40,
                "--candidate-revision", "b" * 40, "--source-revision", "c" * 40,
                "--baseline-build-type", "Release", "--candidate-build-type", "Release",
                "--baseline-assertions", "on", "--candidate-assertions", "on",
                "--clang-source-root", str(self.source), "--compilation-database", str(self.build),
                "--output-dir", str(self.work / "out"), "--repetitions", "2", "--timeout", "2", *extra]
        result = subprocess.run(args, capture_output=True, text=True, timeout=40)
        self.last_stdout = result.stdout
        self.assertEqual(result.returncode, expected, result.stdout + result.stderr)
        if expected:
            return result
        return json.loads((self.work / "out/report.json").read_text())

    def test_source_root_alias(self):
        self.database([("clean", [])])
        report = self.run_benchmark("--source-root", str(self.source))
        self.assertEqual(report["source"]["root"], str(self.source))

    def test_profiles_are_associated_with_each_invocation(self):
        self.database([("clean", [])])
        report = self.run_benchmark("--profile-checks", "--check-option", "NumThreads=2")
        self.assertEqual(report["profiling"]["common_profiled_units"], 1)
        self.assertEqual(report["profiling"]["tidy_phase_profiled_units"],
                         {"baseline": 1, "candidate": 1})
        self.assertEqual(report["summary"]["candidate"]["tidy_phase_profile_status_counts"],
                         {"parsed": 2})
        self.assertEqual(report["profiling"]["per_unit"][0]["candidate"]
                         ["tidy_phase_wall_seconds"]["tu_callbacks"], 0.03)
        self.assertNotIn("candidate_over_baseline_check_wall_ratio", report["profiling"]["per_unit"][0])
        for run in report["runs"]:
            self.assertEqual(run["check_profile"]["status"], "parsed")
            self.assertEqual(run["check_profile"]["wall_seconds"], 0.02)
            self.assertEqual(run["tidy_phase_profile"]["status"], "parsed")
            self.assertEqual(set(run["tidy_phase_profile"]["phases"]),
                             {"consumer_setup", "frontend_before_tu", "tu_callbacks"})
            self.assertGreaterEqual(run["tidy_phase_profile"]["phases"]
                                    ["tu_callbacks"]["wall_seconds"],
                                    run["check_profile"]["wall_seconds"])
            self.assertEqual(run["cir_profile"]["effective_threads"], 2)
            self.assertEqual(set(run["cir_profile"]["wall_seconds"]),
                             {"generation", "verification", "canonicalization", "lifetime"})

    def test_missing_and_invalid_profiles_do_not_become_zero_timings(self):
        self.database([("missing-profile", []), ("invalid-profile", [])])
        report = self.run_benchmark("--profile-checks")
        self.assertEqual(report["profiling"]["common_profiled_units"], 0)
        self.assertEqual(report["profiling"]["excluded_common_units"], 2)
        for run in report["runs"]:
            self.assertEqual(run["status"], "success")
            self.assertEqual(run["check_profile"]["status"],
                             "missing" if "missing" in run["relative_file"] else "invalid")
            self.assertNotIn("wall_seconds", run["check_profile"])
            self.assertEqual(run["tidy_phase_profile"]["status"],
                             "missing" if "missing" in run["relative_file"] else "parsed")

    def test_invalid_tidy_phase_does_not_become_zero_timing(self):
        self.database([("invalid-phase", [])])
        report = self.run_benchmark("--profile-checks")
        self.assertEqual(report["profiling"]["tidy_phase_profiled_units"],
                         {"baseline": 0, "candidate": 0})
        self.assertEqual(report["summary"]["candidate"]["tidy_phase_profile_status_counts"],
                         {"invalid": 2})
        for run in report["runs"]:
            self.assertEqual(run["status"], "success")
            self.assertEqual(run["check_profile"]["status"], "parsed")
            self.assertEqual(run["tidy_phase_profile"]["status"], "invalid")
            self.assertNotIn("phases", run["tidy_phase_profile"])

    def test_profiled_different_checks_do_not_claim_unbiased_timing_ratios(self):
        self.database([("clean", [])])
        report = self.run_benchmark("--profile-checks", "--baseline-check",
                                    "bugprone-use-after-move", "--eligibility-driver",
                                    str(self.work / "clang++"))
        self.assertIsNone(report["comparison"]["candidate_over_baseline_wall_ratio"])
        self.assertIn("matcher-dependent", report["comparison"]["timing_ratio_unavailable_reason"])
        self.assertNotIn("candidate_over_baseline_wall_ratio", report["comparison"]["per_unit"][0])
        self.assertEqual(report["profiling"]["common_profiled_units"], 1)
        self.assertNotIn("candidate_over_baseline_check_wall_ratio", report["profiling"]["per_unit"][0])

    def test_independent_phase_modes_allow_cross_check_ratios(self):
        self.database([("clean", [])])
        report = self.run_benchmark("--baseline-profile-mode", "phases",
                                    "--candidate-profile-mode", "phases",
                                    "--baseline-check", "bugprone-use-after-move",
                                    "--eligibility-driver", str(self.work / "clang++"))
        self.assertEqual(report["schema_version"], 3)
        self.assertEqual(report["measurement_validation"]["status"], "valid")
        self.assertIsNotNone(report["comparison"]["candidate_over_baseline_wall_ratio"])
        self.assertEqual(report["profiling"]["per_unit"][0]
                         ["candidate_over_baseline_tu_analysis_wall_ratio"], 1)
        for run in report["runs"]:
            self.assertNotIn("--enable-check-profile", run["command"])
            self.assertTrue(any(a.startswith("--store-phase-profile=") for a in run["command"]))
            self.assertNotIn("check_profile", run)
            self.assertNotIn("cir_profile", run)
            self.assertEqual(run["tidy_phase_profile"]["metadata"]["clock_reads"], 4)

    def test_detailed_and_asymmetric_modes_do_not_claim_check_ratios(self):
        self.database([("clean", [])])
        report = self.run_benchmark("--baseline-profile-mode", "phases",
                                    "--candidate-profile-mode", "phases+cir")
        self.assertIsNone(report["comparison"]["candidate_over_baseline_wall_ratio"])
        self.assertNotIn("candidate_over_baseline_tu_analysis_wall_ratio", report["profiling"]["per_unit"][0])
        for run in report["runs"]:
            self.assertNotIn("--enable-check-profile", run["command"])
            self.assertEqual("cir_profile" in run, run["variant"] == "candidate")

    def test_bad_successful_profiles_fail_measurement_validation(self):
        self.database([("clean", []), ("invalid-phase", [])])
        report = self.run_benchmark("--baseline-profile-mode", "phases",
                                    "--candidate-profile-mode", "phases")
        self.assertEqual(report["measurement_validation"]["failure_count"], 4)
        self.assertEqual(report["comparison"]["timing_units"], ["clean.cpp"])
        self.assertIn("Validated timing cohort: 1/2 units", self.last_stdout)
        self.assertIn("Measurement validation failed: 4", self.last_stdout)
        self.assertIsNone(report["comparison"]["candidate_over_baseline_wall_ratio"])
        self.assertTrue(all(r["status"] == "success" for r in report["runs"]))
        self.assertGreater(report["summary"]["candidate"]["excluded_input_wall_seconds"], 0)

    def test_profile_mode_conflicts_fail_before_running(self):
        self.database([("clean", [])])
        result = self.run_benchmark("--profile-checks", "--baseline-profile-mode", "off", expected=2)
        self.assertIn("cannot be combined", result.stderr)
        result = self.run_benchmark("--baseline-check", "bugprone-use-after-move",
                                    "--baseline-profile-mode", "phases+cir", expected=2)
        self.assertIn("requires cir-lifetime-check", result.stderr)

    def test_same_binary_instrumentation_overhead_is_labeled(self):
        self.database([("clean", [])])
        report = self.run_benchmark("--candidate", str(self.work / "baseline"),
                                    "--candidate-profile-mode", "phases")
        self.assertEqual(report["comparison"]["comparison_kind"], "instrumentation_overhead")
        self.assertIsNotNone(report["comparison"]["candidate_over_baseline_wall_ratio"])
        self.assertNotIn("candidate_over_baseline_tu_analysis_wall_ratio", report["profiling"]["per_unit"][0])

    def test_different_binary_asymmetric_modes_suppress_ratio(self):
        self.database([("clean", [])])
        candidate = self.work / "candidate"
        candidate.write_text(candidate.read_text() + "\n# distinct executable identity\n")
        report = self.run_benchmark("--candidate-profile-mode", "phases")
        self.assertIsNone(report["comparison"]["candidate_over_baseline_wall_ratio"])
        self.assertEqual(report["comparison"]["comparison_kind"], "checker_comparison")

    def test_legacy_overhead_pair_is_labeled(self):
        self.database([("clean", [])])
        report = self.run_benchmark("--candidate", str(self.work / "baseline"),
                                    "--candidate-profile-mode", "legacy")
        self.assertEqual(report["comparison"]["comparison_kind"], "instrumentation_overhead")
        self.assertIsNotNone(report["comparison"]["candidate_over_baseline_wall_ratio"])
        self.assertNotIn("candidate_over_baseline_tu_analysis_wall_ratio", report["profiling"]["per_unit"][0])

    def test_matching_detailed_modes_suppress_ratio(self):
        self.database([("clean", [])])
        report = self.run_benchmark("--baseline-profile-mode", "phases+cir",
                                    "--candidate-profile-mode", "phases+cir")
        self.assertIsNone(report["comparison"]["candidate_over_baseline_wall_ratio"])
        self.assertNotIn("candidate_over_baseline_tu_analysis_wall_ratio", report["profiling"]["per_unit"][0])

    def test_profile_intervals_cannot_exceed_process_time(self):
        spec = importlib.util.spec_from_file_location("wall_runner", RUNNER)
        runner = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(runner)
        run = {"profile_mode": "phases", "status": "success", "eligibility": {"eligible": True},
               "check": "bugprone-use-after-move", "wall_seconds": .5,
               "tidy_phase_profile": {"status": "parsed", "phases": {"tu_callbacks": {"wall_seconds": 1}}}}
        self.assertEqual(runner.validate_profiles(run), {"status": "failed", "failures": {
                         "tidy_phase_profile": "intervals exceed process wall time"}})
        run["status"] = "frontend_failure"
        self.assertEqual(runner.validate_profiles(run), {"status": "not_applicable"})

    def test_historical_schema_two_retains_legacy_interpretation(self):
        spec = importlib.util.spec_from_file_location("historical_runner", RUNNER)
        runner = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(runner)
        phases = {name: {"wall_seconds": .03, "user_seconds": .008, "sys_seconds": .001}
                  for name in ("consumer_setup", "frontend_before_tu", "tu_callbacks")}
        stock = {"file": str(self.source / "clean.cpp"), "phase_schema_version": 1,
                 "phases": phases, "profile": {"time.clang-tidy.cir-lifetime-check." + k: v
                                               for k, v in (("wall", .02), ("user", .01), ("sys", .001))}}
        directory = self.work / "historical"
        directory.mkdir()
        (directory / "timing.json").write_text(json.dumps(stock))
        profile = runner.support.read_check_profile(directory, "cir-lifetime-check", self.source / "clean.cpp", self.build)
        phase = runner.support.read_tidy_phase_profile(directory, self.source / "clean.cpp", self.build)
        self.assertEqual(phase, {"status": "parsed", "files": [str(directory / "timing.json")], "phases": phases})
        report = {"schema_version": 2, "measurement": {"repetitions": 1, "check_profiling": True},
                  "selection": {"units": [{"relative_file": "clean.cpp"}]},
                  "binaries": {v: {"check": "cir-lifetime-check"} for v in ("baseline", "candidate")},
                  "runs": [{"variant": v, "relative_file": "clean.cpp", "status": "success", "wall_seconds": wall,
                            "peak_rss_bytes": 100, "diagnostics": [], "check_profile": profile,
                            "tidy_phase_profile": phase} for v, wall in (("baseline", 2), ("candidate", 3))]}
        runner.summarize(report)
        # These are the pre-amendment schema-2 results, including its legacy
        # same-check stock-profile ratio. New schema-3 gates must not alter them.
        self.assertEqual(report["comparison"]["candidate_over_baseline_wall_ratio"], 1.5)
        self.assertEqual(report["profiling"]["per_unit"], [{"relative_file": "clean.cpp",
            "baseline": {"wall_seconds": .02, "user_seconds": .01, "sys_seconds": .001,
                         "tidy_phase_wall_seconds": {n: .03 for n in phases}},
            "candidate": {"wall_seconds": .02, "user_seconds": .01, "sys_seconds": .001,
                          "tidy_phase_wall_seconds": {n: .03 for n in phases}},
            "candidate_over_baseline_check_wall_ratio": 1.0}])
        self.assertNotIn("measurement_validation", report)

    def test_invalid_thread_count_is_a_setup_error(self):
        self.database([("clean", [])])
        result = self.run_benchmark("--check-option", "NumThreads=-1", expected=2)
        self.assertIn("NumThreads must be an unsigned 32-bit integer", result.stderr)

    def test_incomplete_cir_stages_have_a_separate_denominator(self):
        self.database([("incomplete-cir", [])])
        report = self.run_benchmark("--profile-checks")
        self.assertEqual(report["profiling"]["common_profiled_units"], 0)
        self.assertEqual(report["measurement_validation"]["failure_count"], 4)
        self.assertEqual(report["profiling"]["cir_stage_profiled_units"], {"baseline":0, "candidate":0})
        for run in report["runs"]:
            self.assertEqual(run["status"], "success")
            self.assertEqual(run["check_profile"]["status"], "parsed")
            self.assertEqual(run["cir_profile"]["status"], "incomplete")

    def test_extreme_and_malformed_profile_numbers_are_invalid(self):
        spec = importlib.util.spec_from_file_location("profile_runner", RUNNER)
        runner = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(runner)
        source = self.work / "source.cpp"
        directory = self.work / "profile"
        directory.mkdir()
        check = "cir-lifetime-check"
        for value in (10**400, True, float("nan")):
            profile = {"file":str(source), "profile":{
                "time.clang-tidy." + check + "." + key: value for key in ("wall","user","sys")}}
            (directory / "check.json").write_text(json.dumps(profile))
            self.assertEqual(runner.support.read_check_profile(directory,check,source,self.work)["status"], "invalid")
            cir = {"schema_version":1, "file":str(source), "complete":True,
                   "requested_threads":1, "effective_threads":1,
                   "timing":[{"name":"CIR generation", "wall":{"duration":value}}]}
            path = self.work / "cir.json"
            path.write_text(json.dumps(cir))
            self.assertEqual(runner.support.read_cir_profile(path,source,self.work)["status"], "invalid")

    @unittest.skipUnless(HAS_YAML, "optional PyYAML dependency")
    def test_independent_checks_options_and_yaml_groups(self):
        self.database([("clean", ["-std=c++17"])])
        report = self.run_benchmark("--baseline-check", "bugprone-use-after-move",
                                    "--candidate-check-option", "HistLimit=2",
                                    "--eligibility-driver", str(self.work / "clang++"))
        self.assertEqual(report["analysis_configs"]["baseline"]["CheckOptions"], {
            "bugprone-use-after-move.InvalidationFunctions": "",
            "bugprone-use-after-move.ReinitializationFunctions": ""})
        self.assertEqual(report["analysis_configs"]["candidate"]["CheckOptions"]["cir-lifetime-check.HistLimit"], "2")
        for run in report["runs"]:
            self.assertEqual(run["diagnostic_export"]["status"], "parsed")
            self.assertEqual(len(run["diagnostic_groups"]), 1)
            self.assertEqual(len(run["diagnostic_groups"][0]["notes"]), 1)

    def test_warmups_are_retained_but_do_not_enter_measured_cohort(self):
        self.database([("clean", []), ("warmup-failure", []), ("measured-failure", [])])
        report = self.run_benchmark("--warmups", "1")
        self.assertEqual(len(report["runs"]), 18)
        self.assertEqual(sum(r["phase"] == "warmup" for r in report["runs"]), 6)
        self.assertEqual(report["summary"]["baseline"]["completed_runs"], 6)
        self.assertEqual(report["summary"]["baseline"]["warmup_status_counts"], {"success": 2, "frontend_failure": 1})
        self.assertEqual(report["comparison"]["common_successful_units"], ["clean.cpp", "warmup-failure.cpp"])

    def test_parallel_batches_never_overlap_checks_and_alternate_rounds(self):
        self.database([(str(i), []) for i in range(4)])
        report = self.run_benchmark("--jobs", "2", "--warmups", "1", "--execution-mode", "batches")
        batches = report["batches"]
        self.assertEqual([(b["phase"], b["variant"]) for b in batches], [
            ("warmup", "baseline"), ("warmup", "candidate"),
            ("measured", "candidate"), ("measured", "baseline"),
            ("measured", "baseline"), ("measured", "candidate")])
        self.assertTrue(all(b["completed_runs"] == 4 and b["wall_seconds"] > 0 for b in batches))
        events = [json.loads(line) for line in (self.work / "trace.jsonl").read_text().splitlines()]
        active = {}; peak = 0
        for event in events:
            key = (event["variant"], event["phase"], event["file"])
            if event["event"] == "start": active[key] = event["variant"]
            else: del active[key]
            self.assertLessEqual(len(set(active.values())), 1)
            peak = max(peak, len(active))
        self.assertEqual(peak, 2)
        self.assertIsNone(report["comparison"]["candidate_over_baseline_wall_ratio"])

    @unittest.skipUnless(HAS_YAML, "optional PyYAML dependency")
    def test_effective_language_and_standard_exclude_inactive_check(self):
        self.database([("cpp17", ["-std=c++17"]), ("cpp98", ["-std=c++98"]),
                       ("forced-c", ["-x", "c", "-std=c11"]),
                       ("last-x-wins", ["-x", "c", "-x", "c++", "-std=c++11"])])
        report = self.run_benchmark("--baseline-check", "bugprone-use-after-move",
                                    "--eligibility-driver", str(self.work / "clang++"))
        self.assertEqual(report["comparison"]["common_successful_units"], ["cpp17.cpp", "last-x-wins.cpp"])
        self.assertEqual(report["summary"]["baseline"]["ineligible_units"], ["cpp98.cpp", "forced-c.cpp"])
        self.assertEqual(len(report["runs"]), 16)

    def test_frozen_selection_preserves_generated_units_and_provenance(self):
        entry = self.database([("source", [])])[0]
        generated = self.build / "generated.cpp"
        generated.write_text("int generated;\n")
        command = dict(entry, file=str(generated), arguments=[str(self.work / "clang++"), "-c", str(generated)])
        units = [{"id": "frozen-generated", "relative_file": "generated/project/generated.cpp",
                  "project": "clang", "origin": "generated", "command": command,
                  "discarded_commands": 7}]
        selection = self.work / "selection.json"
        selection.write_text(json.dumps({"selection": {"units": units}}))
        report = self.run_benchmark("--selection-file", str(selection))
        self.assertEqual(report["selection"]["units"], units)
        self.assertEqual(report["comparison"]["common_successful_units"], [units[0]["relative_file"]])

    def test_input_manifest_mismatch_prevents_analysis(self):
        self.database([("clean", [])])
        header = self.work / "input.h"; header.write_text("changed\n")
        manifest = self.work / "inputs.json"
        manifest.write_text(json.dumps([{"path": str(header), "sha256": "0" * 64}]))
        result = self.run_benchmark("--input-manifest", str(manifest), expected=2)
        self.assertIn("input fingerprint mismatch", result.stderr)
        self.assertFalse((self.work / "trace.jsonl").exists())

    def test_serial_batches_do_not_claim_paired_ratio(self):
        self.database([("clean", [])])
        report = self.run_benchmark("--execution-mode", "batches")
        self.assertIsNone(report["comparison"]["candidate_over_baseline_wall_ratio"])

    def test_input_change_retains_incomplete_run_evidence(self):
        self.database([("invalidate-input", [])])
        header = self.work / "input.h"; header.write_text("original")
        manifest = self.work / "inputs.json"
        manifest.write_text(json.dumps([{"path": str(header), "sha256": hashlib.sha256(header.read_bytes()).hexdigest()}]))
        result = self.run_benchmark("--input-manifest", str(manifest), expected=2)
        self.assertIn("input fingerprint mismatch", result.stderr)
        report = json.loads((self.work / "out/report.json").read_text())
        self.assertFalse(report["complete"])
        self.assertFalse(report["input_freeze"]["final_verified"])
        self.assertGreater(len(report["runs"]), 0)

    def test_mixed_shared_options_are_rejected_before_analysis(self):
        self.database([("clean", [])])
        result = self.run_benchmark("--baseline-check", "bugprone-use-after-move", "--check-option", "HistLimit=2", expected=2)
        self.assertIn("shared --check-option requires matching checks", result.stderr)
        self.assertFalse((self.work / "trace.jsonl").exists())

    def test_missing_yaml_dependency_is_explicit(self):
        code = ("import importlib.util; s=importlib.util.spec_from_file_location('support', "
                + repr(str(RUNNER.with_name('cir_lifetime_benchmark_support.py')))
                + "); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); m.require_yaml()")
        result = subprocess.run([sys.executable, "-S", "-c", code], capture_output=True, text=True)
        self.assertNotEqual(result.returncode, 0)
        self.assertIn("diagnostic YAML parsing requires PyYAML", result.stderr)


unittest.main()
