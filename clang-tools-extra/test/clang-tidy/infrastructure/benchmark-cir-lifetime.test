# REQUIRES: system-linux || system-darwin
# RUN: split-file %s %t
# RUN: %python %t/test.py %S/../../../clang-tidy/tool/benchmark-cir-lifetime.py %t
# RUN: %python %t/memory_test.py %S/../../../clang-tidy/tool/benchmark-cir-lifetime.py

#--- fixture.py
import json
import os
from pathlib import Path
import signal
import sys
import time

if "--version" in sys.argv:
    print("fixture clang-tidy version 1")
    sys.exit(0)
if "--list-checks" in sys.argv:
    print("Enabled checks:\n    cir-lifetime-check")
    sys.exit(0)

role = Path(sys.argv[0]).name
source = Path(sys.argv[-1])
config = json.loads(next(x.split("=", 1)[1] for x in sys.argv if x.startswith("--config=")))
assert config["Checks"] == "-*,cir-lifetime-check"
assert config["CheckOptions"]["cir-lifetime-check.HistoryList"] == "all"
assert config["WarningsAsErrors"] == ""
assert not any(x in ("--fix", "-fix") for x in sys.argv)
database = Path(next(x[3:] for x in sys.argv if x.startswith("-p=")))
entries = json.loads((database / "compile_commands.json").read_text())
entry = next(x for x in entries if Path(x["file"]) == source)
assert Path.cwd() == Path(entry["directory"])
assert "-DPRESERVED=1" in entry.get("arguments", []) or "-DPRESERVED=1" in entry.get("command", "")
yaml = Path(next(x.split("=", 1)[1] for x in sys.argv if x.startswith("--export-fixes=")))
repeat = int(yaml.parent.name.split("-")[-1])
name = source.stem
colored = name.startswith("ansi-")
name = name.removeprefix("ansi-")


def emit(message):
    if colored:
        # Color spans occur within diagnostic lines, not just around them.
        for token in ("warning:", "note:", "error:", "LLVM ERROR:",
                      "Stack dump:", "Assertion", "failed."):
            message = message.replace(token, "\x1b[0;31m" + token + "\x1b[0m")
        message = "\x1b[1m" + message + "\x1b[0m"
    print(message, file=sys.stderr)


if name == "timeout":
    print("started timeout fixture", flush=True)
    time.sleep(60)
if name == "crash":
    os.kill(os.getpid(), signal.SIGKILL)
if name == "cir-failure" or (name == "asymmetric" and role == "candidate"):
    emit(f"{source}:1:1: error: ClangIR code gen Not Yet Implemented: fixture [clang-diagnostic-error]")
    sys.exit(1)
if name == "frontend-failure":
    emit(f"{source}:1:1: error: unknown type name 'fixture' [clang-diagnostic-error]")
    sys.exit(1)
if name == "false-clean-crash":
    emit("LLVM ERROR: fatal CIR verifier failure")
    sys.exit(0)
if name == "false-clean-stack":
    emit("Stack dump:")
    sys.exit(0)
if name == "false-clean-assert":
    emit("clang-tidy: fixture.cpp:1: void foo(): Assertion 'false' failed.")
    sys.exit(0)
if name == "false-clean":
    emit("error: CIR lifetime analysis failed [cir-lifetime-check]")
    sys.exit(0)
if name == "flaky" and role == "candidate" and repeat == 2:
    emit("error: CIR lifetime analysis failed [cir-lifetime-check]")
    sys.exit(1)
if name == "a-memory":
    allocation = bytearray(64 * 1024 * 1024)
emit(f"{source}:3:4: warning: use of invalid pointer 'Assertion' [cir-lifetime-check]")
emit("    3 | *Assertion = 1; // LLVM ERROR: Stack dump: Assertion 'false' failed.")
emit(f"{source}:2:3: note: pointee 'x' invalidated at end of scope")
yaml.write_text("---\nDiagnostics:\n  - DiagnosticName: cir-lifetime-check\n    Level: Warning\n...\n")

#--- test.py
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import unittest

RUNNER = Path(sys.argv.pop(1)).resolve()
ROOT = Path(sys.argv.pop(1)).resolve()


class BenchmarkTest(unittest.TestCase):
    def setUp(self):
        self.work = ROOT / self._testMethodName
        shutil.rmtree(self.work, ignore_errors=True)
        self.work.mkdir()
        self.source = self.work / "clang source"
        self.source.mkdir()
        self.build = self.work / "build"
        self.build.mkdir()
        fixture = (ROOT / "fixture.py").read_text()
        for role in ("baseline", "candidate"):
            path = self.work / role
            path.write_text("#!" + sys.executable + "\n" + fixture)
            path.chmod(0o755)

    def database(self, names, duplicate=False):
        entries = []
        for name in reversed(names):
            file = self.source / (name + ".cpp")
            file.write_text("void f() {}\n")
            entry = {"directory": str(self.build), "file": str(file),
                     "arguments": ["clang++", "-DPRESERVED=1", "-DA=1", "-c", str(file)]}
            entries.append(entry)
            if duplicate:
                other = dict(entry)
                other["arguments"] = ["clang++", "-DPRESERVED=1", "-DZ=1", "-c", str(file)]
                entries.insert(0, other)
        (self.build / "compile_commands.json").write_text(json.dumps(entries))
        return entries

    def run_benchmark(self, *extra, output="output", expected=0):
        command = [sys.executable, str(RUNNER),
                   "--baseline", str(self.work / "baseline"),
                   "--candidate", str(self.work / "candidate"),
                   "--baseline-revision", "a" * 40,
                   "--candidate-revision", "b" * 40,
                   "--source-revision", "c" * 40,
                   "--baseline-build-type", "Release",
                   "--candidate-build-type", "Release",
                   "--baseline-assertions", "on", "--candidate-assertions", "on",
                   "--clang-source-root", str(self.source),
                   "--compilation-database", str(self.build),
                   "--output-dir", str(self.work / output),
                   "--repetitions", "2", "--timeout", "1", *extra]
        process = subprocess.run(command, text=True, capture_output=True, timeout=30)
        self.assertEqual(process.returncode, expected, process.stdout + process.stderr)
        if expected:
            return process
        return json.loads((self.work / output / "report.json").read_text())

    def test_common_cohort_excludes_any_failed_repetition(self):
        self.database(["clean", "asymmetric", "flaky"])
        report = self.run_benchmark()
        self.assertEqual(len(report["runs"]), 12)
        self.assertEqual(report["summary"]["baseline"]["successful_units"], 3)
        self.assertEqual(report["summary"]["candidate"]["successful_units"], 1)
        comparison = report["comparison"]
        self.assertTrue(comparison["available"])
        self.assertEqual(comparison["common_successful_units"], ["clean.cpp"])
        self.assertGreater(comparison["candidate_over_baseline_wall_ratio"], 0)
        self.assertEqual(report["binaries"]["baseline"]["revision"], "a" * 40)
        self.assertIn("fixture clang-tidy", report["binaries"]["candidate"]["version"])
        successes = [run for run in report["runs"] if run["status"] == "success"]
        for run in successes:
            self.assertGreater(run["peak_rss_bytes"], 0)
            self.assertGreater(run["wall_seconds"], 0)
            self.assertEqual([d["level"] for d in run["diagnostics"]], ["warning", "note"])
            self.assertTrue((self.work / "output" / run["diagnostics_yaml"]).is_file())
        self.assertEqual(report["summary"]["candidate"]["status_counts"]["pass_failure"], 1)

    def test_failure_statuses_and_empty_cohort(self):
        self.database(["timeout", "crash", "cir-failure", "frontend-failure", "false-clean", "false-clean-crash", "false-clean-assert"])
        report = self.run_benchmark("--repetitions", "1", "--timeout", "0.5")
        self.assertFalse(report["comparison"]["available"])
        self.assertIsNone(report["comparison"]["candidate_over_baseline_wall_ratio"])
        self.assertEqual(report["comparison"]["common_successful_units"], [])
        for role in ("baseline", "candidate"):
            self.assertEqual(report["summary"][role]["status_counts"],
                             {"cir_failure": 1, "crash": 3, "frontend_failure": 1,
                              "pass_failure": 1, "timeout": 1})
            self.assertEqual(report["summary"][role]["successful_units"], 0)
            # Failed runs still expose resource maxima with an empty timing
            # cohort; in particular the timed-out invocation is not hidden.
            self.assertGreaterEqual(report["summary"][role]["max_wall_seconds_all_runs"], 0.5)
            self.assertGreater(report["summary"][role]["max_peak_rss_bytes_all_runs"], 0)
        for run in report["runs"]:
            if run["status"] == "timeout":
                self.assertIn("started timeout fixture", (self.work / "output" / run["stdout_log"]).read_text())
                self.assertGreaterEqual(run["wall_seconds"], 0.5)

    def test_selection_and_duplicates_are_deterministic(self):
        entries = self.database(["zeta", "alpha", "middle"], duplicate=True)
        first = self.run_benchmark("--limit", "1", "--file-filter", "alpha|middle")
        (self.build / "compile_commands.json").write_text(json.dumps(list(reversed(entries))))
        second = self.run_benchmark("--limit", "1", "--file-filter", "alpha|middle", output="second")
        self.assertEqual(first["selection"]["units"], second["selection"]["units"])
        self.assertEqual(first["selection"]["frozen_database_sha256"], second["selection"]["frozen_database_sha256"])
        self.assertEqual([x["relative_file"] for x in first["selection"]["units"]], ["alpha.cpp"])
        frozen = json.loads((self.work / "output" / "compilation-database" / "compile_commands.json").read_text())
        self.assertEqual(len(frozen), 1)
        self.assertIn("-DA=1", frozen[0]["arguments"])
        self.assertEqual(first["selection"]["units"][0]["discarded_commands"], 1)

    def test_ansi_diagnostics_and_crashes_preserve_raw_logs(self):
        expected = {"clean": "success", "cir-failure": "cir_failure",
                    "frontend-failure": "frontend_failure", "false-clean": "pass_failure",
                    "false-clean-crash": "crash", "false-clean-stack": "crash",
                    "false-clean-assert": "crash"}
        self.database(["ansi-" + name for name in expected])
        report = self.run_benchmark("--repetitions", "1")
        for role in ("baseline", "candidate"):
            self.assertEqual(report["summary"][role]["status_counts"],
                             {"success": 1, "cir_failure": 1, "frontend_failure": 1,
                              "pass_failure": 1, "crash": 3})
            self.assertEqual(report["summary"][role]["diagnostic_counts_all_runs"],
                             {"error": 3, "warning": 1, "note": 1})
        self.assertEqual(report["comparison"]["common_successful_units"], ["ansi-clean.cpp"])
        for run in report["runs"]:
            name = Path(run["relative_file"]).stem.removeprefix("ansi-")
            self.assertEqual(run["status"], expected[name])
            raw = (self.work / "output" / run["stderr_log"]).read_bytes()
            self.assertTrue(raw.startswith(b"\x1b[1m"))
            self.assertIn(b"\x1b[0;31m", raw)
            self.assertTrue(raw.endswith(b"\x1b[0m\n"))
            for diagnostic in run["diagnostics"]:
                for value in diagnostic.values():
                    if isinstance(value, str):
                        self.assertNotIn("\x1b", value)
            if name == "clean":
                warning, note = run["diagnostics"]
                self.assertEqual(warning, {
                    "file": str(self.source / "ansi-clean.cpp"), "line": 3, "column": 4,
                    "level": "warning", "check": "cir-lifetime-check",
                    "message": "use of invalid pointer 'Assertion'"})
                self.assertEqual(note["level"], "note")
                self.assertEqual(note["line"], 2)
                self.assertEqual(note["column"], 3)
                self.assertIsNone(note["check"])

    def test_memory_is_per_process_not_cumulative(self):
        self.database(["a-memory", "z-small"])
        report = self.run_benchmark("--repetitions", "1")
        for role in ("baseline", "candidate"):
            runs = {run["relative_file"]: run for run in report["runs"] if run["variant"] == role}
            self.assertGreater(runs["a-memory.cpp"]["peak_rss_bytes"],
                               runs["z-small.cpp"]["peak_rss_bytes"] + 32 * 1024 * 1024)

    def test_command_entries_preserve_working_directory_and_quoting(self):
        entries = self.database(["file with spaces"])
        entry = entries[0]
        command = shlex.join(entry.pop("arguments"))
        entry["command"] = command
        entry["file"] = os.path.relpath(entry["file"], self.build)
        entry["directory"] = "."
        (self.build / "compile_commands.json").write_text(json.dumps(entries))
        report = self.run_benchmark("--repetitions", "1")
        self.assertTrue(report["comparison"]["available"])
        self.assertEqual(report["selection"]["units"][0]["command"]["command"], command)

    def test_missing_check_cannot_be_reported_as_clean(self):
        self.database(["clean"])
        candidate = self.work / "candidate"
        candidate.write_text(candidate.read_text().replace(
            'print("Enabled checks:\\n    cir-lifetime-check")', 'print("Enabled checks:")'))
        process = self.run_benchmark(expected=2)
        self.assertIn("candidate does not register cir-lifetime-check", process.stderr)
        self.assertFalse((self.work / "output" / "report.json").exists())


unittest.main()

#--- memory_test.py
import importlib.util
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time
import unittest
from concurrent.futures import ThreadPoolExecutor

sys.dont_write_bytecode = True
RUNNER = Path(sys.argv.pop(1)).resolve()
spec = importlib.util.spec_from_file_location('memory_test_runner', RUNNER)
runner = importlib.util.module_from_spec(spec)
spec.loader.exec_module(runner)


class ResourceMeasurementTest(unittest.TestCase):
    def setUp(self):
        self.directory = tempfile.TemporaryDirectory()
        self.root = Path(self.directory.name)

    def tearDown(self):
        self.directory.cleanup()

    def measure(self, name, code, timeout=10, cwd=None, args=()):
        out, err = self.root / (name + '.out'), self.root / (name + '.err')
        result = runner.measure_process([sys.executable, '-c', code, *args],
            str(cwd or self.root), dict(os.environ, CIR_MEMORY_TEST='preserved'),
            timeout, out, err)
        return result, out.read_text(), err.read_text()

    def test_resident_parent_and_parallel_children(self):
        retained = bytearray(256 * 1024 * 1024)
        for offset in range(0, len(retained), 4096):
            retained[offset] = 29
        code = """import os,sys,time
from pathlib import Path
assert os.environ['CIR_MEMORY_TEST'] == 'preserved'
n=int(sys.argv[1]); token=Path(sys.argv[2]); release=Path(sys.argv[3])
data=bytearray(n*1024*1024)
for offset in range(0,len(data),4096): data[offset]=17
token.with_suffix('.ready').touch()
while not release.exists(): time.sleep(.002)
token.with_suffix('.done').write_text(str(time.monotonic()))
print(os.getpid(),n,os.getcwd(),flush=True)
"""
        def wait_for(paths):
            deadline = time.monotonic() + 8
            while not all(path.exists() for path in paths):
                self.assertLess(time.monotonic(), deadline, 'allocation control did not reach gate')
                time.sleep(.005)
        for workers in (1, 16):
            for large_first in (False, True):
                sizes = ([64,8] if large_first else [8,64]) if workers == 1 else [8,64]*8
                prefix = self.root / f'{workers}-{large_first}'
                gates = {mib: Path(str(prefix) + f'-release-{mib}') for mib in (8,64)}
                tokens = [Path(str(prefix) + f'-{i}') for i in range(len(sizes))]
                if workers == 1:
                    for gate in gates.values(): gate.touch()
                with ThreadPoolExecutor(max_workers=workers) as pool:
                    jobs = [pool.submit(self.measure, f'{workers}-{large_first}-{i}', code,
                            args=(str(mib),str(tokens[i]),str(gates[mib])))
                            for i,mib in enumerate(sizes)]
                    try:
                        if workers == 16:
                            wait_for([t.with_suffix('.ready') for t in tokens])
                            first = 64 if large_first else 8
                            gates[first].touch()
                            wait_for([t.with_suffix('.done') for t,m in zip(tokens,sizes) if m==first])
                            gates[72-first].touch()
                        results = [job.result() for job in jobs]
                    finally:
                        for gate in gates.values(): gate.touch(exist_ok=True)
                small, large = [], []
                for mib, (result, out, err) in zip(sizes, results):
                    self.assertEqual((result[0], result[3]), (0,None), err)
                    self.assertEqual(err, '')
                    self.assertIn(str(self.root), out)
                    (small if mib==8 else large).append(result[2])
                if workers == 16:
                    first_done=[float(t.with_suffix('.done').read_text()) for t,m in zip(tokens,sizes) if m==first]
                    second_done=[float(t.with_suffix('.done').read_text()) for t,m in zip(tokens,sizes) if m!=first]
                    self.assertLess(max(first_done),min(second_done))
                self.assertGreater(min(large), max(small) + 32*1024*1024)
                self.assertLess(max(large), len(retained) - 64*1024*1024)

    def test_launch_failure_and_checker_exit_are_distinct(self):
        result, _, err = self.measure('bad-cwd', 'pass', cwd=self.root/'missing')
        self.assertEqual((result[0],result[2],result[3]), (None,None,'launch_failure'))
        self.assertTrue(err)
        result, _, _ = self.measure('exit127', 'raise SystemExit(127)')
        self.assertEqual((result[0],result[3]), (127,None))
        self.assertGreater(result[2], 0)

    def test_crash_retains_child_status_and_resources(self):
        result, _, _ = self.measure('crash', 'import os,signal; os.kill(os.getpid(),signal.SIGKILL)')
        self.assertEqual((result[0],result[3]), (-signal.SIGKILL,None))
        self.assertGreater(result[2], 0)

    def test_inherited_ignored_signals_survive_supervisor(self):
        original = {sig: signal.getsignal(sig) for sig in (signal.SIGALRM,signal.SIGTERM)}
        try:
            for sig in original: signal.signal(sig, signal.SIG_IGN)
            result, out, err = self.measure('signals',
                'import signal; print(signal.getsignal(signal.SIGALRM)==signal.SIG_IGN, '
                'signal.getsignal(signal.SIGTERM)==signal.SIG_IGN)')
            self.assertEqual((result[0],result[3]), (0,None), err)
            self.assertEqual(out.strip(), 'True True')
        finally:
            for sig, disposition in original.items(): signal.signal(sig, disposition)

    def test_requested_environment_survives_python_startup(self):
        environment = dict(os.environ, LC_CTYPE='C', LANG='C',
            PYTHONCOERCE_C_LOCALE='1', __PYVENV_LAUNCHER__='/preserve-this-value')
        environment.pop('LC_ALL', None)
        out, err = self.root/'environment.out', self.root/'environment.err'
        result = runner.measure_process(
            ['/bin/sh', '-c', 'printf "%s\\n%s\\n" "$LC_CTYPE" "$__PYVENV_LAUNCHER__"'],
            str(self.root), environment, 5, out, err)
        self.assertEqual((result[0],result[3]), (0,None), err.read_text())
        self.assertEqual(out.read_text(), 'C\n/preserve-this-value\n')

    def test_timeout_reaps_child_and_kills_descendant(self):
        pidfile = self.root/'descendant.pid'
        heartbeat = self.root/'heartbeat'
        descendant = ('import os,sys,time; from pathlib import Path; '
            'Path(sys.argv[1]).write_text(str(os.getpid())); '
            '\nwhile True: Path(sys.argv[2]).write_text(str(time.monotonic())); time.sleep(.02)')
        child = ('import subprocess,sys,time; '
            'subprocess.Popen([sys.executable,"-c",sys.argv[1],sys.argv[2],sys.argv[3]]); '
            'print("started",flush=True); time.sleep(60)')
        result, out, err = self.measure('timeout', child, timeout=2,
            args=(descendant,str(pidfile),str(heartbeat)))
        try:
            self.assertEqual((result[0],result[3]), (-signal.SIGKILL,'timeout'), err)
            self.assertGreater(result[2], 0)
            self.assertIn('started', out)
            stamp = heartbeat.read_text()
            time.sleep(.15)
            self.assertEqual(heartbeat.read_text(), stamp)
        finally:
            if pidfile.exists():
                try: os.kill(int(pidfile.read_text()),signal.SIGKILL)
                except ProcessLookupError: pass

    def test_descendant_does_not_hold_result_protocol_open(self):
        release = self.root/'release'
        pidfile = self.root/'remaining.pid'
        descendant = ('import os,sys,time; from pathlib import Path; '
            'Path(sys.argv[1]).write_text(str(os.getpid())); '
            '\nwhile not Path(sys.argv[2]).exists(): time.sleep(.01)')
        child = ('import subprocess,sys; subprocess.Popen('
            '[sys.executable,"-c",sys.argv[1],sys.argv[2],sys.argv[3]]); print("done",flush=True)')
        try:
            result, out, err = self.measure('open-descendant', child, timeout=3,
                args=(descendant,str(pidfile),str(release)))
            self.assertEqual((result[0],result[3]), (0,None), err)
            self.assertIn('done', out)
            self.assertFalse(release.exists())
        finally:
            release.touch()
            if pidfile.exists():
                try: os.kill(int(pidfile.read_text()),signal.SIGKILL)
                except ProcessLookupError: pass

    @unittest.skipUnless(hasattr(runner.support, '_resource_supervisor'), 'new supervisor contract')
    def test_supervisor_failure_is_explicit_and_cleans_compiler(self):
        pidfile = self.root/'orphan.pid'
        heartbeat = self.root/'worker-child-heartbeat'
        child = ('import os,signal,sys,time; from pathlib import Path; '
            'Path(sys.argv[1]).write_text(str(os.getpid())); '
            'Path(sys.argv[2]).write_text("started"); '
            'os.kill(os.getppid(),signal.SIGKILL); '
            '\nwhile True: Path(sys.argv[2]).write_text(str(time.monotonic())); time.sleep(.02)')
        started = time.monotonic()
        result, _, err = self.measure('worker-failure', child, timeout=3,
            args=(str(pidfile),str(heartbeat)))
        try:
            self.assertEqual((result[0],result[2],result[3]), (None,None,'measurement_failure'))
            self.assertIn('resource measurement failed', err)
            self.assertLess(time.monotonic()-started, 8)
            stamp = heartbeat.read_text()
            time.sleep(.15)
            self.assertEqual(heartbeat.read_text(), stamp)
        finally:
            if pidfile.exists():
                try: os.kill(int(pidfile.read_text()),signal.SIGKILL)
                except ProcessLookupError: pass



if __name__ == '__main__':
    unittest.main()
