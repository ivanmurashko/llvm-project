// RUN: cir-opt %s -verify-diagnostics -split-input-file

// expected-error @below {{guaranteed move parameter is outside the source parameter array}}
module attributes {facts = #cir.lifetime_function<is_method = true, is_static = false, is_const = false, is_overloaded_operator = false, has_implicit_object = true, parameter_kinds = [2], parameter_indices = [1], library_function = try_emplace, insertion_result_index = 1, guaranteed_move_params = [1]>} {}

// -----

// expected-error @below {{guaranteed move parameters must be nonnegative and strictly increasing}}
module attributes {facts = #cir.lifetime_function<is_method = true, is_static = false, is_const = false, is_overloaded_operator = false, has_implicit_object = true, parameter_kinds = [2], parameter_indices = [1], library_function = try_emplace, insertion_result_index = 1, guaranteed_move_params = [-1]>} {}

// -----

// expected-error @below {{guaranteed move parameters must be nonnegative and strictly increasing}}
module attributes {facts = #cir.lifetime_function<is_method = true, is_static = false, is_const = false, is_overloaded_operator = false, has_implicit_object = true, parameter_kinds = [2], parameter_indices = [1], library_function = try_emplace, insertion_result_index = 1, guaranteed_move_params = [0, 0]>} {}

// -----

// expected-error @below {{a guaranteed move parameter must be an rvalue reference}}
module attributes {facts = #cir.lifetime_function<is_method = true, is_static = false, is_const = false, is_overloaded_operator = false, has_implicit_object = true, parameter_kinds = [1], parameter_indices = [1], library_function = try_emplace, insertion_result_index = 1, guaranteed_move_params = [0]>} {}

// -----

// expected-error @below {{guaranteed move parameters require a try_emplace contract}}
module attributes {facts = #cir.lifetime_function<is_method = true, is_static = false, is_const = false, is_overloaded_operator = false, has_implicit_object = true, parameter_kinds = [2], parameter_indices = [1], library_function = reset, guaranteed_move_params = [0]>} {}

// -----

// expected-error @below {{guaranteed move parameters require a try_emplace contract}}
module attributes {facts = #cir.lifetime_function<is_method = false, is_static = false, is_const = false, is_overloaded_operator = false, guaranteed_move_params = [0]>} {}
