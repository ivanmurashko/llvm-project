// RUN: cir-opt %s -verify-diagnostics -split-input-file

// expected-error @below {{tuple element kinds require the tuple library kind}}
module attributes {facts = #cir.lifetime_record<owner = false, pointer = false, lambda = false, promise_type = false, tuple_element_kinds = [0]>} {}

// -----

// expected-error @below {{invalid lifetime tuple element kind}}
module attributes {facts = #cir.lifetime_record<owner = false, pointer = false, lambda = false, promise_type = false, library_kind = tuple, tuple_element_kinds = [3]>} {}

// -----

// expected-error @below {{tuple element parameters require a constructor or make_tuple contract}}
module attributes {facts = #cir.lifetime_function<is_method = true, is_static = false, is_const = false, is_overloaded_operator = false, has_implicit_object = true, parameter_kinds = [0], parameter_indices = [1], library_function = reset, tuple_element_params = [0]>} {}

// -----

// expected-error @below {{tuple element parameters must be nonnegative and strictly increasing}}
module attributes {facts = #cir.lifetime_function<is_method = false, is_static = false, is_const = false, is_overloaded_operator = false, parameter_kinds = [0], parameter_indices = [0], library_function = make_tuple, tuple_element_params = [-1]>} {}

// -----

// expected-error @below {{tuple element parameter is outside the source parameter array}}
module attributes {facts = #cir.lifetime_function<is_method = false, is_static = false, is_const = false, is_overloaded_operator = false, parameter_kinds = [0], parameter_indices = [0], library_function = make_tuple, tuple_element_params = [1]>} {}

// -----

// expected-error @below {{tuple element parameters must be nonnegative and strictly increasing}}
module attributes {facts = #cir.lifetime_function<is_method = false, is_static = false, is_const = false, is_overloaded_operator = false, parameter_kinds = [0], parameter_indices = [0], library_function = make_tuple, tuple_element_params = [0, 0]>} {}
