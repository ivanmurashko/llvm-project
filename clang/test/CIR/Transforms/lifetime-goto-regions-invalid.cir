// RUN: diff %t/duplicate.serial %t/duplicate.text.parallel
// RUN: not cir-opt %t/duplicate.bc --mlir-disable-threading=true --cir-lifetime-check="history=all" -o /dev/null 2> %t/duplicate.bytecode.serial
// RUN: diff %t/duplicate.serial %t/duplicate.bytecode.serial
