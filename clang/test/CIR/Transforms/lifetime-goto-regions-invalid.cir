//--- missing.cir
module {
  cir.func @missing() {
    cir.goto "not_defined" loc("goto-missing":1:1)
  }
}

//--- duplicate.cir
module {
  cir.func @duplicate() {
    cir.label "same" loc("goto-first-label":1:1)
    cir.return
  ^other:
    cir.label "same" loc("goto-duplicate-label":1:1)
    cir.return
  }
}

//--- label-argument.cir
module {
  cir.func @label_argument() {
    cir.return
  ^unused(%argument: !cir.int<s, 32>):
    cir.label "unused" loc("goto-label-argument":1:1)
    cir.return
  }
}

//--- indirect.cir
module {
  cir.func @indirect(%address: !cir.ptr<!cir.void>) {
    cir.indirect_goto %address : !cir.ptr<!cir.void> loc("goto-indirect":1:1)
  }
}

//--- inward-scope.cir
module {
  cir.func @inward_scope() {
    cir.goto "inside" loc("goto-inward-scope":1:1)
  ^otherwise_unreachable:
    cir.scope {
      cir.label "inside"
      cir.yield
    }
    cir.return
  }
}

//--- incoming-case.cir
module {
  cir.func @incoming_case(%selector: !cir.int<s, 32>) {
    cir.goto "inside_case" loc("goto-incoming-case":1:1)
  ^otherwise_unreachable:
    cir.switch (%selector : !cir.int<s, 32>) {
      cir.case(default, []) {
        cir.label "inside_case"
        cir.break
      }
      cir.yield
    } loc("goto-incoming-switch":1:1)
    cir.return
  }
}

//--- cross-case.cir
module {
  cir.func @cross_case(%selector: !cir.int<s, 32>) {
    cir.switch (%selector : !cir.int<s, 32>) {
      cir.case(equal, [#cir.int<0> : !cir.int<s, 32>]) {
        cir.goto "other_case" loc("goto-cross-case":1:1)
      }
      cir.case(default, []) {
        cir.label "other_case"
        cir.break
      }
      cir.yield
    } loc("goto-cross-case-switch":1:1)
    cir.return
  }
}

//--- sibling-if.cir
module {
  cir.func @sibling_if(%condition: !cir.bool) {
    cir.if %condition {
      cir.goto "sibling" loc("goto-sibling-region":1:1)
    } else {
      cir.label "sibling"
      cir.yield
    }
    cir.return
  }
}

//--- nested-case.cir
module {
  cir.func @nested_case(%selector: !cir.int<s, 32>) {
    cir.switch (%selector : !cir.int<s, 32>) {
      cir.case(equal, [#cir.int<0> : !cir.int<s, 32>]) {
        cir.scope {
          cir.case(equal, [#cir.int<1> : !cir.int<s, 32>]) {
            cir.break
          }
          cir.yield
        }
        cir.break
      }
      cir.case(default, []) { cir.break }
      cir.yield
    } loc("goto-nested-case":1:1)
    cir.return
  }
}

//--- unsupported-successor.cir
module {
  cir.func @unsupported_successor(%selector: !cir.int<s, 32>, %condition: !cir.bool) {
    cir.switch (%selector : !cir.int<s, 32>) {
      cir.case(default, []) {
        cir.brcond %condition ^left, ^right loc("goto-unsupported-successor":1:1)
      ^left:
        cir.break
      ^right:
        cir.break
      }
      cir.yield
    } loc("goto-unsupported-successor-switch":1:1)
    cir.return
  }
}

//--- nonlinear-shell.cir
module {
  cir.func private @side_effect() attributes {nothrow}
  cir.func @nonlinear_shell(%selector: !cir.int<s, 32>) {
    cir.switch (%selector : !cir.int<s, 32>) {
      cir.case(default, []) { cir.break }
      cir.yield
    ^extra_shell:
      cir.call @side_effect() nothrow : () -> ()
      cir.yield
    } loc("goto-nonlinear-shell":1:1)
    cir.return
  }
}
